# Server
PORT=5001

# One shared Supabase (Postgres) project for everything — tenants, users,
# contacts, social_accounts, etc. Run backend/migrations/*.sql against it
# in order before starting the server.
SUPABASE_URL_SOCIAL=
SUPABASE_KEY_SOCIAL=

# Public URLs used to build OAuth redirect URIs and the post-connect
# browser redirect back into the app.
BACKEND_PUBLIC_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Signs login/session JWTs. No fallback on purpose — the server refuses
# to start without this set (see lib/auth.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encrypts social_accounts.access_token/refresh_token at rest (AES-256-GCM).
# Generate the same way as JWT_SECRET above.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# One GCP OAuth 2.0 Client (Web application), shared by youtube.js and
# google-business.js. Add these redirect URIs to it:
#   {BACKEND_PUBLIC_URL}/api/v1/social/callback/youtube
#   {BACKEND_PUBLIC_URL}/api/v1/social/callback/google_business
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# One Meta App (developers.facebook.com), "Facebook Login for Business"
# product, shared by facebook.js, instagram.js and whatsapp.js. Add these
# redirect URIs to it:
#   {BACKEND_PUBLIC_URL}/api/v1/social/callback/facebook
#   {BACKEND_PUBLIC_URL}/api/v1/social/callback/instagram
#   {BACKEND_PUBLIC_URL}/api/v1/social/callback/whatsapp
# pages_manage_posts / instagram_content_publish / whatsapp_business_messaging
# all need Meta App Review (Advanced Access) before they work for any
# tenant besides this app's own dev-mode testers — start that process
# early, see the strategy doc's Scalability Risks section.
META_APP_ID=
META_APP_SECRET=

# WhatsApp webhook (backend/routes/social.js's publicRouter). Under the
# app's WhatsApp -> Configuration -> Webhook settings, subscribe to the
# `messages` field with:
#   Callback URL:  {BACKEND_PUBLIC_URL}/api/v1/social/webhook/whatsapp
#   Verify token:  same value as below
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Embedded Signup — reuses META_APP_ID/META_APP_SECRET above, no
# separate app/secret needed. See developers.facebook.com -> your app ->
# WhatsApp -> Configuration -> Embedded Signup to create one and get its id.
WHATSAPP_SIGNUP_CONFIG_ID=

# LinkedIn ("Sign In with LinkedIn using OpenID Connect" + "Share on
# LinkedIn" products, both self-serve). Add this redirect URL:
#   {BACKEND_PUBLIC_URL}/api/v1/social/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Sales Hub email/calendar connections (backend/routes/salesEmail.js) —
# see SALES_HUB_IMPLEMENTATION.md's "Blocked: Email & Calendar". Both
# are optional and independent: leaving either unset just leaves that
# provider's Connect button disabled in Sales Hub Settings, nothing
# fails to start.
#
# A new Google Cloud OAuth 2.0 Client (Web application) — deliberately
# NOT the same one as GOOGLE_OAUTH_CLIENT_ID above, which is scoped to
# Business Profile/YouTube, a different consent screen and set of
# scopes. Enable the Gmail API + Google Calendar API on it, then add:
#   {BACKEND_PUBLIC_URL}/api/v1/sales/email/callback/gmail
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# A Microsoft Entra ID (Azure AD) app registration with Mail.Send/
# Mail.Read/Calendars.ReadWrite delegated Graph API permissions granted.
# Add this redirect URI:
#   {BACKEND_PUBLIC_URL}/api/v1/sales/email/callback/microsoft365
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=

# Redis for the BullMQ publish queue (backend/social/queue.js). Point this
# at a managed instance (e.g. Upstash) in production.
REDIS_URL=redis://localhost:6379

# Razorpay subscriptions (backend/routes/billing.js). Plan ids are created
# once in the Razorpay dashboard, not here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=

# AI Assist — Compose's "AI Assist" draft mode and Inbox's "AI Suggest"
# reply button (backend/lib/ai.js, backend/routes/ai.js). Without this
# set, both features return a clear 503 instead of being offered; no
# hardcoded fallback key.
ANTHROPIC_API_KEY=

# SMTP — forgot-password reset emails and email-verification links
# (backend/lib/email.js). Works with any SMTP provider (Gmail app
# password, Amazon SES, SendGrid, Mailgun, Resend's SMTP endpoint —
# whichever you already use). Without these set, /auth/forgot-password
# and /auth/send-verification-email return a clear 503 instead of
# silently pretending an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
