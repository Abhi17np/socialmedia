# Server
PORT=5000

# One shared Supabase (Postgres) project for everything — tenants, users,
# contacts, social_accounts, etc. Run backend/migrations/*.sql against it
# in order before starting the server.
SUPABASE_URL_SOCIAL=
SUPABASE_KEY_SOCIAL=

# Public URLs used to build OAuth redirect URIs and the post-connect
# browser redirect back into the app.
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5174

# Signs login/session JWTs. No fallback on purpose — the server refuses
# to start without this set (see lib/auth.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encrypts social_accounts.access_token/refresh_token at rest (AES-256-GCM).
# Generate the same way as JWT_SECRET above.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# One GCP OAuth 2.0 Client (Web application), shared by youtube.js and
# google-business.js. Add these redirect URIs to it:
#   {BACKEND_PUBLIC_URL}/api/social/callback/youtube
#   {BACKEND_PUBLIC_URL}/api/social/callback/google_business
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# One Meta App (developers.facebook.com), "Facebook Login for Business"
# product, shared by facebook.js, instagram.js and whatsapp.js. Add these
# redirect URIs to it:
#   {BACKEND_PUBLIC_URL}/api/social/callback/facebook
#   {BACKEND_PUBLIC_URL}/api/social/callback/instagram
#   {BACKEND_PUBLIC_URL}/api/social/callback/whatsapp
# pages_manage_posts / instagram_content_publish / whatsapp_business_messaging
# all need Meta App Review (Advanced Access) before they work for any
# tenant besides this app's own dev-mode testers — start that process
# early, see the strategy doc's Scalability Risks section.
META_APP_ID=
META_APP_SECRET=

# WhatsApp webhook (backend/routes/social.js's publicRouter). Under the
# app's WhatsApp -> Configuration -> Webhook settings, subscribe to the
# `messages` field with:
#   Callback URL:  {BACKEND_PUBLIC_URL}/api/social/webhook/whatsapp
#   Verify token:  same value as below
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Embedded Signup — reuses META_APP_ID/META_APP_SECRET above, no
# separate app/secret needed. See developers.facebook.com -> your app ->
# WhatsApp -> Configuration -> Embedded Signup to create one and get its id.
WHATSAPP_SIGNUP_CONFIG_ID=

# LinkedIn ("Sign In with LinkedIn using OpenID Connect" + "Share on
# LinkedIn" products, both self-serve). Add this redirect URL:
#   {BACKEND_PUBLIC_URL}/api/social/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Redis for the BullMQ publish queue (backend/social/queue.js). Point this
# at a managed instance (e.g. Upstash) in production.
REDIS_URL=redis://localhost:6379

# Razorpay subscriptions (backend/routes/billing.js). Plan ids are created
# once in the Razorpay dashboard, not here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
